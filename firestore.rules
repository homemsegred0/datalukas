rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              request.auth.token.email == 'admin@datalukas.com');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get username from email
    function getUsernameFromEmail(email) {
      return email.split('@')[0];
    }
    
    // Attendants collection - employee data and scores
    match /attendants/{attendantId} {
      // Anyone authenticated can read attendant data
      allow read: if isAuthenticated();
      
      // Only admins can write to attendant data (including scores)
      allow write: if isAdmin();
      
      // Allow employees to read their own data
      allow read: if isAuthenticated() && 
                     getUsernameFromEmail(request.auth.token.email) == attendantId;
    }
    
    // Contests collection - score contestations
    match /contests/{contestId} {
      // Users can read their own contests
      allow read: if isAuthenticated() && 
                     (resource.data.by == getUsernameFromEmail(request.auth.token.email) ||
                      isAdmin());
      
      // Admins can read all contests
      allow read: if isAdmin();
      
      // Authenticated users can create contests
      allow create: if isAuthenticated() && 
                       request.resource.data.by == getUsernameFromEmail(request.auth.token.email);
      
      // Only admins can update contest status
      allow update: if isAdmin() && 
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt', 'reviewedBy']);
    }
    
    // Messages collection - anonymous messaging
    match /messages/{messageId} {
      // Users can create messages (anonymous sending)
      allow create: if isAuthenticated();
      
      // Users can read messages sent TO them
      allow read: if isAuthenticated() && 
                     resource.data.to == getUsernameFromEmail(request.auth.token.email);
      
      // Admins can read all messages
      allow read: if isAdmin();
      
      // Users can update their own messages (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.to == getUsernameFromEmail(request.auth.token.email) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'readAt']);
    }
    
    // History collection - score change history
    match /history/{historyId} {
      // Users can read their own history
      allow read: if isAuthenticated() && 
                     resource.data.employeeName == getUsernameFromEmail(request.auth.token.email);
      
      // Admins can read all history
      allow read: if isAdmin();
      
      // Only admins can create history entries
      allow create: if isAdmin();
      
      // No updates or deletes allowed on history (audit trail)
      allow update, delete: if false;
    }
    
    // Users collection - user profiles and roles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Admins can read all profiles
      allow read: if isAdmin();
      
      // Only admins can create/update user profiles
      allow write: if isAdmin();
    }
    
    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // System collections - configuration, etc.
    match /system/{document=**} {
      // Read-only for authenticated users
      allow read: if isAuthenticated();
      
      // Write access only for admins
      allow write: if isAdmin();
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Additional security notes:
// 1. All operations require authentication
// 2. Admin privileges are verified through custom claims or specific email
// 3. Users can only access their own data unless they're admin
// 4. History is append-only (audit trail)
// 5. Messages allow anonymous sending but restrict reading to recipients
// 6. Score updates are admin-only for integrity